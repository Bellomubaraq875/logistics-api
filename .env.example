# Pooled (host has -pooler) for the running app
DATABASE_URL="postgresql://neondb_owner:NEW_PASSWORD@ep-shy-poetry-badyyjij-pooler.c-8.eu-central-1.aws.neon.tech/logisticsdb?sslmode=require&channel_binding=require&connect_timeout=30"
# Direct (no -pooler) for Prisma commands
DIRECT_URL="postgresql://neondb_owner:NEW_PASSWORD@ep-shy-poetry-badyyjij.c-8.eu-central-1.aws.neon.tech/logisticsdb?sslmode=require&channel_binding=require&connect_timeout=30"

JWT_SECRET="at-least-32-random-characters"
JWT_EXPIRES_IN="12h"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Used by the seed script to create the first Super Admin
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="your-real-admin@email.com"
ADMIN_PASSWORD="a-strong-password-of-your-own"

# Password reset emails (Resend)
MAIL_FROM="Logistics Tracker <onboarding@resend.dev>"
RESEND_API_KEY="re_your_key"

npx prisma generate
npx prisma db push
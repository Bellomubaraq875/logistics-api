generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum TaskStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum ProofType {
  PHOTO
  SIGNATURE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks    Task[]            @relation("AssignedTasks")
  createdTasks     Task[]            @relation("CreatedTasks")
  events           TaskEvent[]
  proofs           ProofOfDelivery[]
  expenses         DailyExpense[]    @relation("StaffExpenses")
  reviewedExpenses DailyExpense[]    @relation("ReviewedExpenses")
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  pickupAddress  String
  dropoffAddress String
  customerName   String
  customerPhone  String
  status         TaskStatus @default(PENDING)
  failureReason  String?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // assignedToId = null and status = PENDING means the task is in the open pool
  assignedToId String?
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("CreatedTasks", fields: [createdById], references: [id])

  events TaskEvent[]
  proofs ProofOfDelivery[]

  @@index([assignedToId, status])
  @@index([status])
  @@index([createdAt])
}

// Every status change and GPS check-in is recorded here (the delivery timeline)
model TaskEvent {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  status    TaskStatus
  note      String?
  lat       Float?
  lng       Float?
  accuracy  Float?
  createdAt DateTime   @default(now())

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

model ProofOfDelivery {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])
  type          ProofType
  fileUrl       String
  recipientName String?
  createdAt     DateTime  @default(now())

  @@index([taskId])
}

model DailyExpense {
  id           String        @id @default(cuid())
  staffId      String
  staff        User          @relation("StaffExpenses", fields: [staffId], references: [id])
  date         DateTime      @db.Date
  amount       Decimal       @db.Decimal(12, 2)
  note         String?
  status       ExpenseStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?         @relation("ReviewedExpenses", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // one expense total per staff member per day
  @@unique([staffId, date])
  @@index([status])
}
